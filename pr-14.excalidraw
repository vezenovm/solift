      "groupIds": [],
      "index": "a9",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "- nothing in it changes: no =, ++, delete, gasleft()\n- a local in it is assigned only where declared\n- it names the same declarations at each read\n- a callee that names its own locals runs once\n- refused too: an array index, one callee on two pointers",
      "roughness": 1,
      "roundness": null,
      "seed": 1372068837,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "- nothing in it changes: no =, ++, delete, gasleft()\n- a local in it is assigned only where declared\n- it names the same declarations at each read\n- a callee that names its own locals runs once\n- refused too: an array index, one callee on two pointers",
      "textAlign": "left",
